[Unit]
Description=PulsusDB observability database
Documentation=https://github.com/digitalis-io/pulsusdb
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=pulsusdb
Group=pulsusdb
ExecStart=/usr/bin/pulsusdb --config /etc/pulsusdb/config.yaml
EnvironmentFile=-/etc/pulsusdb/pulsusdb.env
WorkingDirectory=/var/lib/pulsusdb
StateDirectory=pulsusdb
Restart=on-failure
RestartSec=5s
# Hardening (binds unprivileged :3100, so no CAP_NET_BIND_SERVICE)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/pulsusdb

[Install]
WantedBy=multi-user.target
