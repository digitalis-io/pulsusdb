# PulsusDB environment overrides — /etc/pulsusdb/pulsusdb.env
#
# Loaded by the systemd unit (EnvironmentFile=-/etc/pulsusdb/pulsusdb.env). These
# take precedence over /etc/pulsusdb/config.yaml (env wins on conflict) and are
# the right place for secrets, since this file is 0640 root:pulsusdb and stays
# out of the world-readable config schema. Full variable list: docs/configuration.md.
#
# Syntax is systemd EnvironmentFile: KEY=value, one per line, no `export`, no shell
# expansion. Uncomment and edit as needed.

# ClickHouse credentials (user:password, split on first colon).
#CLICKHOUSE_AUTH=default:changeme

# ClickHouse endpoint (overrides clickhouse.server in config.yaml).
#CLICKHOUSE_SERVER=localhost

# HTTP Basic auth for the PulsusDB listener (both must be set to enable).
#PULSUS_AUTH_USER=admin
#PULSUS_AUTH_PASSWORD=changeme
