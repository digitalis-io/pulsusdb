<?xml version="1.0"?>
<!--
  The 2-shard cluster the issue #5 CI leg and tests/live_cluster.rs render
  against; shard 1 has a second replica, `ch-shard1b` (issue #599 part B). `internal_replication = true`
  because the underlying tables are `Replicated*` (docs/schemas.md §7): the
  Distributed layer must write each block to one replica and let
  replication fan it out, never duplicate via the Distributed layer itself.
  Shared verbatim across both ClickHouse nodes so both see the identical
  cluster topology.

  Replica hosts are the fixture's static `ipv4_address`es (compose.yaml,
  172.28.0.0/24) — KISS directive on issue #5: no DNS aliases, no
  service-name resolution anywhere in this fixture.
-->
<clickhouse>
    <remote_servers>
        <pulsus_test_cluster>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>172.28.0.11</host>
                    <port>9000</port>
                </replica>
                <replica>
                    <host>172.28.0.13</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>172.28.0.12</host>
                    <port>9000</port>
                </replica>
            </shard>
        </pulsus_test_cluster>
        <!--
          Used by one test alone, `pushes_keep_being_answered_while_a_replica_is_unreachable`
          in crates/pulsus-write/tests/live_cluster_landing.rs (issue #888): one shard
          whose first replica is host 99 of the fixture's subnet, which no service is
          given, so a connect to it times out inside the network. Its second replica
          is shard 1's first, as in pulsus_test_cluster.
        -->
        <pulsus_test_cluster_drop>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>172.28.0.99</host>
                    <port>9000</port>
                    <priority>1</priority>
                </replica>
                <replica>
                    <host>172.28.0.11</host>
                    <port>9000</port>
                    <priority>2</priority>
                </replica>
            </shard>
        </pulsus_test_cluster_drop>
    </remote_servers>
</clickhouse>
