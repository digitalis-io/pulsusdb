            "ingest_queue_bytes": { "$ref": "#/definitions/ingestQueueBytes" }
          }
        },
        "reader": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cache_ttl": { "$ref": "#/definitions/humanDuration" },
            "cache_max_series": { "type": "integer", "minimum": 1, "maximum": 50000000 },
            "cache_window": { "$ref": "#/definitions/humanDuration" },
            "promql_max_samples": { "type": "integer", "minimum": 1, "maximum": 50000000000 },
            "promql_lookback": { "$ref": "#/definitions/humanDuration" },
            "logql_scan_budget_bytes": { "$ref": "#/definitions/logqlScanBudgetBytes" },
            "traceql_tag_lookback": { "$ref": "#/definitions/positiveHumanDuration" }
          }
        },
        "downsampling": {
          "type": "object",
          "additionalProperties": false,
          "$comment": "The binary refuses enabled: true with no tiers.",
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "properties": { "tiers": { "minItems": 1 } } },
          "properties": {
            "enabled": { "type": "boolean" },
            "raw_retention": { "$ref": "#/definitions/nullablePositiveHumanDuration" },
            "tier_policy": { "type": "string", "enum": ["exact", "fast"] },
            "tiers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "resolution", "table", "retention", "min_step"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "resolution": { "$ref": "#/definitions/positiveHumanDuration" },
                  "table": { "type": "string", "minLength": 1 },
                  "retention": { "$ref": "#/definitions/positiveHumanDuration" },
                  "min_step": { "$ref": "#/definitions/positiveHumanDuration" }
                }
              }
            }
          }
        },
        "ruler": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "poll_interval": { "$ref": "#/definitions/positiveHumanDuration" },
            "max_result_bytes": { "$ref": "#/definitions/byteSize" }
          }
        }
      }
