      "type": "object",
      "additionalProperties": false,
      "description": "A subset of docs/configuration.md §9's YAML schema (secrets excluded) — pulsus-config's own `Config` struct is `#[serde(deny_unknown_fields)]`, so additionalProperties:false here matches the product's behaviour exactly, not just this chart's convention.",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "log_level": { "type": "string", "enum": ["error", "warn", "info", "debug", "trace"] },
        "compat_endpoints": { "type": "boolean" },
        "cors_origin": { "type": "string" },
        "query_timeout": { "$ref": "#/definitions/positiveHumanDuration" },
        "skip_ddl": { "type": "boolean" },
        "retention_days": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "storage_policy": { "type": ["string", "null"] },
        "log_rollup_resolution": { "$ref": "#/definitions/positiveHumanDuration" },
        "cluster": { "type": ["string", "null"] },
        "dist_suffix": { "type": "string", "minLength": 1 },
        "skip_unavailable_shards": { "type": "boolean" },
        "clickhouse": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": { "type": "string", "pattern": "^(\\S(.*\\S)?)?$", "$comment": "No leading or trailing whitespace: the template renders the value as given." },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "http_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "database": { "type": "string", "minLength": 1 },
            "proto": { "type": "string", "enum": ["http", "https"] },
            "tls_skip_verify": { "type": "boolean" },
            "pool_size": { "type": "integer", "minimum": 1, "maximum": 8000 }
          }
        },
        "writer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "batch_bytes": { "$ref": "#/definitions/batchBytes" },
            "batch_ms": { "type": "integer", "minimum": 1, "maximum": 200000 },
