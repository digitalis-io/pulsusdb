{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pulsusdb",
  "description": "Values schema for the pulsusdb Helm chart (issue #38). Covers every documented value (code review round-1 finding #11) with additionalProperties:false on every fully-enumerated ('closed') object (code review round-2 finding #3) — genuinely open passthrough objects (otelCollector.config, *.annotations maps, podLabels/podAnnotations/nodeSelector, raw k8s securityContext/probe/affinity/toleration objects this chart never re-models) are deliberately left open, noted inline. Documented limitations: JSON Schema cannot express 'requests <= limits' quantity-ordering (round-2 amendment §2 — Kubernetes' own API-server admission already rejects requests > limits; a pytest-bdd scenario proves that behaviourally instead of re-implementing it here) nor 'clickhouse.replicasPerShard > 1' as anything richer than a numeric ceiling (the real rule — per-replica macros/Keeper-path identity is unimplemented — is enforced by `_helpers.tpl`'s `pulsusdb.validateReplicasPerShard` `fail` guard at template time).",
  "type": "object",
  "required": ["image", "topology", "pulsusdb", "clickhouse"],
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$",
          "description": "Immutable digest pin, preferred over `tag` when set (`_helpers.tpl`'s `pulsusdb.image` — issue #38 #115 group)."
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "A k8s LocalObjectReference — genuinely just {name}.",
        "properties": { "name": { "type": "string" } }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "topology": {
      "type": "string",
      "enum": ["single", "cluster"],
      "description": "The ClickHouse topology axis, orthogonal to pulsusdb.split.enabled."
    },
    "pulsusdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "split": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "writer": { "$ref": "#/definitions/workload" },
        "reader": { "$ref": "#/definitions/workload" },
        "resources": { "$ref": "#/definitions/resources" },
        "config": { "$ref": "#/definitions/pulsusdbConfig" },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "description": "HTTP Basic auth. The pairing invariant (user+password source both-or-neither, password/existingSecret mutually exclusive) is guard-enforced at template time (`_helpers.tpl`'s `pulsusdb.validateAuth`, the `validateClickhouseAuth` precedent), not expressed here.",
          "properties": {
            "user": { "type": "string" },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" }
          }
        },
        "extraEnv": {
          "type": "array",
          "description": "Standard Kubernetes env var list — appended after the chart's own env vars, so entries here can override them.",
          "items": { "$ref": "#/definitions/envVar" }
        },
        "spool": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "$ref": "#/definitions/storageQuantity" },
                "storageClass": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "initJob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "clickhouse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "shards", "replicasPerShard"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1, "pattern": "^[^@]+(@sha256:[0-9a-f]{64})?$" },
        "keeperImage": { "type": "string", "minLength": 1, "pattern": "^[^@]+(@sha256:[0-9a-f]{64})?$" },
        "shards": { "type": "integer", "minimum": 1 },
        "replicasPerShard": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1,
          "description": "Restricted to 1 (documented follow-up: per-replica macros.xml/Keeper-path identity is unimplemented)."
        },
        "clusterName": { "type": "string", "minLength": 1 },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": { "type": "string", "minLength": 1 },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string", "minLength": 1 },
            "existingSecretInterserverKey": { "type": "string", "minLength": 1 }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "keeperResources": { "$ref": "#/definitions/resources" },
        "podSecurityContext": { "type": "object", "description": "Raw k8s PodSecurityContext passthrough — deliberately not re-modeled field-by-field." },
        "securityContext": { "type": "object", "description": "Raw k8s SecurityContext passthrough — deliberately not re-modeled field-by-field." },
        "keeperPodSecurityContext": { "type": "object", "description": "Raw k8s PodSecurityContext passthrough." },
        "keeperSecurityContext": { "type": "object", "description": "Raw k8s SecurityContext passthrough." }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "$ref": "#/definitions/storageQuantity" },
        "storageClass": { "type": "string" },
        "keeperSize": { "$ref": "#/definitions/storageQuantity" }
      }
    },
    "otelCollector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1, "pattern": "^[^@]+(@sha256:[0-9a-f]{64})?$" },
        "config": {
          "type": "object",
          "additionalProperties": true,
          "description": "Passthrough OTel Collector config (code review round-1 finding #11): when non-empty, rendered verbatim, replacing the chart's own release-aware default entirely. Deliberately left OPEN (additionalProperties: true) — not exhaustively schema'd, validated only as 'is an object' here; the collector itself validates its own config shape at startup."
        },
        "resources": { "$ref": "#/definitions/resources" },
        "podSecurityContext": { "type": "object", "description": "Raw k8s PodSecurityContext passthrough." },
        "securityContext": { "type": "object", "description": "Raw k8s SecurityContext passthrough." }
      }
    },
    "grafana": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "datasourceProvisioning": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "description": "Arbitrary annotation map — deliberately left open." }
      }
    },
    "podSecurityContext": { "type": "object", "description": "Raw k8s PodSecurityContext passthrough — deliberately not re-modeled field-by-field." },
    "securityContext": { "type": "object", "description": "Raw k8s SecurityContext passthrough — deliberately not re-modeled field-by-field." },
    "livenessProbe": { "type": "object", "description": "Raw k8s Probe passthrough — port fields are always overridden from pulsusdb.config.port regardless of what's set here." },
    "readinessProbe": { "type": "object", "description": "Raw k8s Probe passthrough." },
    "startupProbe": { "type": "object", "description": "Raw k8s Probe passthrough." },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object", "description": "Arbitrary annotation map — deliberately left open." },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array", "description": "Raw k8s IngressTLS list passthrough — deliberately not re-modeled." }
      }
    },
    "hpa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer", "minimum": 0 }
      }
    },
    "podAnnotations": { "type": "object", "description": "Arbitrary annotation map — deliberately left open." },
    "podLabels": { "type": "object", "description": "Arbitrary label map — deliberately left open." },
    "nodeSelector": { "type": "object", "description": "Arbitrary label-selector map — deliberately left open." },
    "tolerations": { "type": "array", "description": "Raw k8s Toleration list passthrough — deliberately not re-modeled." },
    "affinity": { "type": "object", "description": "Raw k8s Affinity passthrough — deliberately not re-modeled (deeply nested upstream type)." }
  },
  "allOf": [
    {
      "$comment": "AC #4 negative case: topology=cluster requires clickhouse.shards >= 2 (owner-specified cross-field rule).",
      "if": {
        "properties": { "topology": { "const": "cluster" } },
        "required": ["topology"]
      },
      "then": {
        "properties": {
          "clickhouse": {
            "type": "object",
            "properties": { "shards": { "type": "integer", "minimum": 2 } }
          }
        }
      }
    },
    {
      "$comment": "AC #4 negative case: pulsusdb.config.clickhouse.server must be non-empty when clickhouse.enabled=false (external ClickHouse) — also enforced at template time by _helpers.tpl's pulsusdb.validateClickhouseServer fail guard, which produces the more actionable error message; this schema rule is the fast pre-templating rejection.",
      "if": {
        "properties": {
          "clickhouse": {
            "type": "object",
            "properties": { "enabled": { "const": false } },
            "required": ["enabled"]
          }
        },
        "required": ["clickhouse"]
      },
      "then": {
        "properties": {
          "pulsusdb": {
            "type": "object",
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "clickhouse": {
                    "type": "object",
                    "properties": { "server": { "type": "string", "minLength": 1 } },
                    "required": ["server"]
                  }
                },
                "required": ["clickhouse"]
              }
            },
            "required": ["config"]
          }
        },
        "required": ["pulsusdb"]
      }
    }
  ],
  "definitions": {
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|m|k|M|G|T|P|E)?$",
      "description": "A Kubernetes resource quantity (e.g. '20Gi', '500m', '2'). Bare unitless integers (e.g. \"10\") ARE accepted by this pattern for CPU/memory-style quantities per the Kubernetes quantity grammar, where a bare number is meaningful (whole cores, bytes); a value with no digits or an invalid suffix is rejected."
    },
    "storageQuantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)$",
      "description": "A Kubernetes resource quantity with a REQUIRED binary/decimal unit suffix, used for persistence sizes only (AC #4's literal negative case: \"10\" with no unit is rejected — a bare byte count is essentially always a typo for a volume size, unlike cpu/memory where a bare number is meaningful)."
    },
    "humanDuration": {
      "type": "string",
      "pattern": "^[0-9]{1,13}(ms|s|m|h|d|w)$",
      "description": "pulsus-config's HumanDuration where zero is allowed: digits then ms|s|m|h|d|w, no space (docs/configuration.md §9). Thirteen digits keep every unit inside the parser's 64-bit range."
    },
    "positiveHumanDuration": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,12}(ms|s|m|h|d|w)$",
      "description": "A HumanDuration the binary refuses at zero."
    },
    "nullablePositiveHumanDuration": {
      "type": ["string", "null"],
      "pattern": "^[1-9][0-9]{0,12}(ms|s|m|h|d|w)$",
      "description": "A positive HumanDuration that may be null (unset)."
    },
    "byteSize": {
      "type": ["string", "integer"], "minimum": 1, "maximum": 9007199254740991,
      "pattern": "^(?:(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6}|[1-9][0-9]{7}|[1-9][0-9]{8}|[1-9][0-9]{9}|[1-9][0-9]{10}|[1-9][0-9]{11}|[1-9][0-9]{12}|[1-9][0-9]{13}|[1-9][0-9]{14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]|900719925474099[0-1])|(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6}|[1-9][0-9]{7}|[1-9][0-9]{8}|[1-9][0-9]{9}|[1-9][0-9]{10}|[1-9][0-9]{11}|[1-9][0-9]{12}|[1-9][0-9]{13}|[1-9][0-9]{14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]|900719925474099[0-1])B|(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6}|[1-9][0-9]{7}|[1-9][0-9]{8}|[1-9][0-9]{9}|[1-9][0-9]{10}|[1-9][0-9]{11}|[1-8][0-9]{12}|900[0-6][0-9]{9}|90070[0-9]{8}|90071[0-8][0-9]{7}|900719[0-8][0-9]{6}|9007199[0-1][0-9]{5}|90071992[0-4][0-9]{4}|900719925[0-3][0-9]{3}|9007199254[0-6][0-9]{2}|90071992547[0-3][0-9]|9007199254740)KB|(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6}|[1-9][0-9]{7}|[1-9][0-9]{8}|[1-8][0-9]{9}|900[0-6][0-9]{6}|90070[0-9]{5}|90071[0-8][0-9]{4}|900719[0-8][0-9]{3}|9007199[0-1][0-9]{2}|90071992[0-4][0-9]|900719925[0-4])MB|(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|[1-8][0-9]{6}|900[0-6][0-9]{3}|9007[0-1][0-9]{2})GB|(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-8][0-9]{3}|900[0-7])TB|(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6}|[1-9][0-9]{7}|[1-9][0-9]{8}|[1-9][0-9]{9}|[1-9][0-9]{10}|[1-9][0-9]{11}|[1-7][0-9]{12}|8[0-6][0-9]{11}|87[0-8][0-9]{10}|879[0-5][0-9]{9}|87960[0-8][0-9]{7}|879609[0-2][0-9]{6}|87960930[0-1][0-9]{4}|879609302[0-1][0-9]{3}|8796093022[0-1][0-9]{2}|879609302220[0-7])KiB|(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6}|[1-9][0-9]{7}|[1-9][0-9]{8}|[1-7][0-9]{9}|8[0-4][0-9]{8}|85[0-7][0-9]{7}|858[0-8][0-9]{6}|8589[0-8][0-9]{5}|85899[0-2][0-9]{4}|858993[0-3][0-9]{3}|8589934[0-4][0-9]{2}|85899345[0-8][0-9]|858993459[0-1])MiB|(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|[1-7][0-9]{6}|8[0-2][0-9]{5}|83[0-7][0-9]{4}|838[0-7][0-9]{3}|8388[0-5][0-9]{2}|838860[0-7])GiB|(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-7][0-9]{3}|80[0-9]{2}|81[0-8][0-9]|819[0-1])TiB)$",
      "description": "pulsus-config's ByteSize where the binary has no ceiling: at most 2^53-1 bytes, the maximum safe integer for readers based on binary64 (IEEE 754 double) numbers. The pattern accepts exactly the strings whose value is between 1 and that maximum: a bare integer, or digits with B, KB, MB, GB, TB, KiB, MiB, GiB or TiB, no space."
    },
    "batchBytes": {
      "type": ["string", "integer"], "minimum": 1, "maximum": 17179869184,
      "pattern": "^(?:(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6}|[1-9][0-9]{7}|[1-9][0-9]{8}|[1-9][0-9]{9}|1[0-6][0-9]{9}|170[0-9]{8}|171[0-6][0-9]{7}|1717[0-8][0-9]{6}|17179[0-7][0-9]{5}|171798[0-5][0-9]{4}|1717986[0-8][0-9]{3}|171798690[0-9]{2}|171798691[0-7][0-9]|1717986918[0-4])|(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6}|[1-9][0-9]{7}|[1-9][0-9]{8}|[1-9][0-9]{9}|1[0-6][0-9]{9}|170[0-9]{8}|171[0-6][0-9]{7}|1717[0-8][0-9]{6}|17179[0-7][0-9]{5}|171798[0-5][0-9]{4}|1717986[0-8][0-9]{3}|171798690[0-9]{2}|171798691[0-7][0-9]|1717986918[0-4])B|(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6}|1[0-6][0-9]{6}|170[0-9]{5}|171[0-6][0-9]{4}|1717[0-8][0-9]{3}|17179[0-7][0-9]{2}|171798[0-6][0-9])KB|(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|1[0-6][0-9]{3}|170[0-9]{2}|171[0-7][0-9])MB|(?:[1-9]|1[0-7])GB|(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6}|1[0-5][0-9]{6}|16[0-6][0-9]{5}|167[0-6][0-9]{4}|1677[0-6][0-9]{3}|16777[0-1][0-9]{2}|1677720[0-9]|1677721[0-6])KiB|(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|1[0-5][0-9]{3}|16[0-2][0-9]{2}|163[0-7][0-9]|1638[0-4])MiB|(?:[1-9]|1[0-6])GiB)$",
      "description": "pulsus-config's ByteSize under the binary's ceiling. Both forms are bounded by it: the integer by `maximum`, the string by the pattern, which accepts exactly the strings whose value is between 1 and the ceiling."
    },
    "ingestQueueBytes": {
