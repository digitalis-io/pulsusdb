# b20 — a MALFORMED `ip()` label-filter pattern: rejected in exactly one
# position, silently deferred in every other (issue #248).
#
# Reference of record: grafana/loki:3.7.4, digest
# sha256:87f0a067673756a3cede1bcbf0c74875f7df9b09fddb53e399d0c576f756cfcc.
# Container identity READ FROM THE RUNNING PROCESS, not from this header:
# /loki/api/v1/status/buildinfo answered {"version":"3.7.4",
# "revision":"b318f282","branch":"release-3.7.x"} — the same b318f282 the
# pinned digest and the Go checkout at v3.7.4 resolve to. Captured
# 2026-08-05; every row re-run against a freshly started container on
# 2026-08-06 and re-produced its committed value.
#
# THE RULE, read off the reference's structure and then measured.
# `log.NewIPLabelFilter` cannot fail: it records the parse error on the
# node and leaves the matcher nil (pkg/logql/log/ip.go:94-103 @ v3.7.4).
# The ONLY caller of `PatternError()` is `LabelFilterExpr.Stage()`
# (pkg/logql/syntax/ast.go:801-809 @ v3.7.4), which type-switches on the
# stage's WHOLE filterer. So the pattern error surfaces iff the malformed
# `ip()` filter IS the entire `| <label filter>` pipeline stage. And there
# are only two places a `| <label filter>` can sit at all: `git grep -n
# labelFilter v3.7.4 -- pkg/logql/syntax/syntax.y` returns nine lines —
# the `%type` declaration (58), its own production (302, 307-311), and two
# USES: 221 (a pipeline stage) and 160 (a post-`unwrap` filter).
#
#   | addr = ip("nope")                 400   the filterer IS the ip filter
#   | (addr = ip("nope"))               400   parens are transparent
#                                             (syntax.y:307 @ v3.7.4)
#   | addr = ip("nope") and b="x"       200   the filterer is a Binary…
#   | addr = ip("nope"), b="x"          200   …`,` is `and`
#   | addr = ip("nope") or b="x"        200   …so is `or`
#   | unwrap val | addr = ip("nope")    200   post-`unwrap` filters are
#                                             reduced with
#                                             ReduceAndLabelFilter
#                                             (extractor.go:76,187), which
#                                             never calls Stage() — so EVERY
#                                             position is accepted there,
#                                             a lone filter included
#
# WHAT THE DEFERRED FILTER THEN EVALUATES TO. `filterTy`
# (ip.go:123-145 @ v3.7.4) checks `lbs.HasErr()` first (return true), then
# the label, then `f.ip == nil` (return false) — all BEFORE the `=`/`!=`
# switch. So the leaf is `true` on an entry carrying a pipeline error and
# `false` on every other, for BOTH operators. The discriminating row is
# `addr != ip("nope") or b="y"` below: it returns only the b="y" line, so
# `!=` does NOT negate the malformed leaf to true. (The witness this issue
# was filed on — `a=ip("nope") and b="x"` — could not tell always-false
# from always-true, because its other arm was independently false.)
#
# The `eval_fail` rows pin the rejections. Their HTTP 400 and the
# reference's own body were captured in the same run
# (`parse error : stage '| addr=ip("nope")' : ip: invalid pattern:
# "nope"`); the `msg:` gate is a fragment of PulsusDB's own Display, which
# the owner's 2026-07-26 ruling relaxes to wording-independent.
#
# provenance: captured
# (file default; see logqltest/PROVENANCE.md §provenance markers.
#  A row may override it with its own `# provenance:` line.)

# --- nested under and / , / or, on clean entries ----------------------
load
  {service_name="svc-ipnest"}
  0s   addr=10.1.2.3 b=x
  5s   addr=192.168.1.1 b=y
  10s  other=1 b=x

# The malformed leaf is false, so the `or` is carried by its other arm.
eval instant at 60s {service_name="svc-ipnest"} | logfmt | addr = ip("nope") or b="x"
  {addr="10.1.2.3", b="x", service_name="svc-ipnest"}  0s   addr=10.1.2.3 b=x
  {b="x", other="1", service_name="svc-ipnest"}        10s  other=1 b=x

# Same on the right-hand side — position under the combinator is irrelevant.
eval instant at 60s {service_name="svc-ipnest"} | logfmt | b="x" or addr = ip("nope")
  {addr="10.1.2.3", b="x", service_name="svc-ipnest"}  0s   addr=10.1.2.3 b=x
  {b="x", other="1", service_name="svc-ipnest"}        10s  other=1 b=x

# THE DISCRIMINATOR: `!=` is false too, not negated-true. Only the b="y"
# line comes back — had the malformed leaf been true under `!=`, all three
# would have.
eval instant at 60s {service_name="svc-ipnest"} | logfmt | addr != ip("nope") or b="y"
  {addr="192.168.1.1", b="y", service_name="svc-ipnest"}  5s  addr=192.168.1.1 b=y

# `and` with a false leaf is empty however true the other arm is.
eval instant at 60s {service_name="svc-ipnest"} | logfmt | addr = ip("nope") and b="x"

# `,` is `and` (syntax.y:310 @ v3.7.4) — same answer.
eval instant at 60s {service_name="svc-ipnest"} | logfmt | addr = ip("nope"), b="x"

eval instant at 60s {service_name="svc-ipnest"} | logfmt | addr != ip("nope") and b="x"

# Parenthesised nesting is still nesting — the stage's filterer is the
# outer `or`, so nothing reports.
eval instant at 60s {service_name="svc-ipnest"} | logfmt | (addr = ip("nope") or b="zzz") or b="x"
  {addr="10.1.2.3", b="x", service_name="svc-ipnest"}  0s   addr=10.1.2.3 b=x
  {b="x", other="1", service_name="svc-ipnest"}        10s  other=1 b=x

# Control: a WELL-FORMED nested `ip()` still matches — the deferral does
# not turn nested ip() into a no-op.
eval instant at 60s {service_name="svc-ipnest"} | logfmt | addr = ip("10.0.0.0/8") or b="y"
  {addr="10.1.2.3", b="x", service_name="svc-ipnest"}     0s  addr=10.1.2.3 b=x
  {addr="192.168.1.1", b="y", service_name="svc-ipnest"}  5s  addr=192.168.1.1 b=y

# A later WELL-FORMED lone stage does not un-defer the earlier nested one.
eval instant at 60s {service_name="svc-ipnest"} | logfmt | addr = ip("nope") or b="x" | b="x"
  {addr="10.1.2.3", b="x", service_name="svc-ipnest"}  0s   addr=10.1.2.3 b=x
  {b="x", other="1", service_name="svc-ipnest"}        10s  other=1 b=x

# The same shape inside a range aggregation.
eval instant at 60s count_over_time({service_name="svc-ipnest"} | logfmt | addr = ip("nope") or b="x" [5m])
  {addr="10.1.2.3", b="x", service_name="svc-ipnest"}  1
  {b="x", other="1", service_name="svc-ipnest"}        1

# --- the reported position: the filter IS the stage --------------------
eval_fail instant at 60s {service_name="svc-ipnest"} | logfmt | addr = ip("nope")
  msg: ip()

eval_fail instant at 60s {service_name="svc-ipnest"} | logfmt | (addr = ip("nope"))
  msg: ip()

eval_fail instant at 60s {service_name="svc-ipnest"} | logfmt | addr != ip("nope")
  msg: ip()

# A second stage is a stage of its own — the earlier `b="x"` does not
# shelter it.
eval_fail instant at 60s {service_name="svc-ipnest"} | logfmt | b="x" | addr = ip("nope")
  msg: ip()

clear

# --- an ERRORED entry passes the malformed leaf unconditionally --------
load
  {service_name="svc-ipjson"}
  0s  not json at all
  5s  {"addr":"10.1.2.3","b":"x"}

# `HasErr` is checked before the nil matcher, so the errored line passes
# and the clean one does not — for `=` …
eval instant at 60s {service_name="svc-ipjson"} | json | addr = ip("nope") or b="zzz"
  {__error__="JSONParserErr", __error_details__="Value looks like object, but can't find closing '}' symbol", service_name="svc-ipjson"}  0s  not json at all

# … and identically for `!=`.
eval instant at 60s {service_name="svc-ipjson"} | json | addr != ip("nope") or b="zzz"
  {__error__="JSONParserErr", __error_details__="Value looks like object, but can't find closing '}' symbol", service_name="svc-ipjson"}  0s  not json at all

# `and` with a false other arm is empty even for the errored line.
eval instant at 60s {service_name="svc-ipjson"} | json | addr = ip("nope") and b="zzz"

# Control: a well-formed nested ip() takes the same errored-line
# short-circuit AND matches the clean line.
eval instant at 60s {service_name="svc-ipjson"} | json | addr = ip("10.0.0.0/8") or b="zzz"
  {__error__="JSONParserErr", __error_details__="Value looks like object, but can't find closing '}' symbol", service_name="svc-ipjson"}  0s  not json at all
  {addr="10.1.2.3", b="x", service_name="svc-ipjson"}  5s  {"addr":"10.1.2.3","b":"x"}

clear

# --- post-`unwrap` filters: accepted in EVERY position -----------------
load
  {service_name="svc-ipuw"}
  0s   addr=10.1.2.3 b=x val=1
  5s   addr=192.168.1.1 b=y val=2
  10s  other=1 b=x val=4

# A LONE malformed filter after `unwrap` is a 200, not a 400 — the
# position, not the shape, is what decides.
eval instant at 60s sum_over_time({service_name="svc-ipuw"} | logfmt | unwrap val | addr = ip("nope") [5m])

eval instant at 60s sum_over_time({service_name="svc-ipuw"} | logfmt | unwrap val | (addr = ip("nope")) [5m])

eval instant at 60s sum_over_time({service_name="svc-ipuw"} | logfmt | unwrap val | addr != ip("nope") [5m])

eval instant at 60s sum_over_time({service_name="svc-ipuw"} | logfmt | unwrap val | b="x" | addr = ip("nope") [5m])

eval instant at 60s sum_over_time({service_name="svc-ipuw"} | logfmt | unwrap val | addr = ip("nope") or b="x" [5m])
  {addr="10.1.2.3", b="x", service_name="svc-ipuw"}  1
  {b="x", other="1", service_name="svc-ipuw"}        4

# Control: a well-formed post-`unwrap` ip() filter still selects.
eval instant at 60s sum_over_time({service_name="svc-ipuw"} | logfmt | unwrap val | addr = ip("10.0.0.0/8") [5m])
  {addr="10.1.2.3", b="x", service_name="svc-ipuw"}  1

# The SAME filter one stage earlier — before the `unwrap`, so a pipeline
# stage again — reports.
eval_fail instant at 60s sum_over_time({service_name="svc-ipuw"} | logfmt | addr = ip("nope") | unwrap val [5m])
  msg: ip()
