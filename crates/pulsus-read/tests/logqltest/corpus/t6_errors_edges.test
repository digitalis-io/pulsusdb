# --- issue #294: the argument reaches the parser as RAW BYTES ------
# Captured 2026-08-26 from grafana/loki:3.7.4, digest
# sha256:87f0a067673756a3cede1bcbf0c74875f7df9b09fddb53e399d0c576f756cfcc.
# Before #294 PulsusDB repaired the argument to U+FFFD before parsing
# it, so every escape below came out `\xef\xbf\xbd` instead of the
# byte the reference prints. Go's `time.quote` renders one `\xNN` per
# INVALID byte and three for a genuine U+FFFD, which is what the
# `Ye+/vWI=` row (5 B: 61 EF BF BD 62) separates from a naive
# per-byte rule. Payload lengths: `/////////////w==` = 10 B,
# `YYCA` = 3 B, `4IA=` = 2 B, `MTL/` = 3 B, `Ye+/vWI=` = 5 B,
# `YQli` = 3 B, `YSJi` = 3 B.

eval instant at 1785119441989621248ns {service_name="t6s0r1785119441"} | line_format `{{ duration (b64dec "/////////////w==") }}`
  {__error__="TemplateFormatErr", __error_details__="template: line:1:3: executing \"line\" at <duration (b64dec \"/////////////w==\")>: error calling duration: time: invalid duration \"\\xff\\xff\\xff\\xff\\xff\\xff\\xff\\xff\\xff\\xff\"", a="Hello", arr="[5,6,7]", b="x", b64="aGVsbG8=", big="hello world of words", dur="250ms", epoch="1673798889", js="{\"a\":1,\"b\":[1,2,null],\"s\":\"x\",\"neg\":-2.5,\"t\":true}", n="5", nested="{\"o\":{\"p\":{\"q\":\"deep\"}},\"l\":[[1,2],[3]]}", path="/api/v1/users?q=a b&x=1", service_name="t6s0r1785119441", sz="1KB", u="héllo"} 1785119321000000000ns level=info msg="hi there" took=250ms

