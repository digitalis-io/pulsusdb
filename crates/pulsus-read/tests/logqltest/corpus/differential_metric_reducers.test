# Ported instant-eval subset of differential.json — client-aggregated
# metric reducers, vector aggregation, scalar binop, rate_counter, and
# sort/sort_desc ordering. Every value is EXACT-f64: counts and clean
# divisions are hand-derived; the rate_counter values are F4's (issue #624,
# part 4; ledger `rate-counter-window-anchored`), derived by hand in
# logql_metric_agg_golden.rs. See PROVENANCE.md.
#
# provenance: ported(test/fixtures/logs/differential.json)
# (file default; see logqltest/PROVENANCE.md §provenance markers.
#  A row may override it with its own `# provenance:` line.)

# --- count_over_time over a json+filter pipeline; * scalar ------------
load
  {env="prod", service_name="svc-json"} service=svc-json
  0s   {"status":500,"method":"GET"}
  5s   {"status":500,"method":"GET"}
  10s  {"status":200,"method":"POST"}

eval instant at 60s count_over_time({service_name="svc-json"} | json | status = "500" [30m])
  {env="prod", service_name="svc-json", status="500", method="GET"} 2

eval instant at 60s count_over_time({service_name="svc-json"} | json | status = "500" [30m]) * 2
  {env="prod", service_name="svc-json", status="500", method="GET"} 4

clear

# --- sum_over_time over unwrap duration(took) (exact 0.25s samples) ---
load
  {env="prod", service_name="svc-logfmt"} service=svc-logfmt
  0s  took=250ms
  5s  took=250ms

eval instant at 60s sum_over_time({service_name="svc-logfmt"} | logfmt took | unwrap duration(took) [30m])
  {env="prod", service_name="svc-logfmt"} 0.5

clear

# --- sum by (level) over a client-aggregated count_over_time ----------
load
  {env="prod", service_name="svc-logfmt"} service=svc-logfmt
  0s   level=error msg=a
  5s   level=error msg=b
  10s  level=info msg=c

eval instant at 60s sum by (level) (count_over_time({service_name="svc-logfmt"} | logfmt [30m]))
  {level="error"} 2
  {level="info"} 1

clear

# --- rate_counter: reset-aware increase, F4's extrapolation ----------
# Each block is a single counter series `c=<n>` (logfmt | unwrap c). Each
# value is extrapolated in seconds to the edges of the window `(0, 60s]`
# and derived in logql_metric_agg_golden.rs (ledger
# `rate-counter-window-anchored`).

# Reset mid-window (10,30,5,12 @ 10s..40s, span 30s): increase 32.
load
  {env="prod", service_name="checkout"} service=checkout
  10s  c=10
  20s  c=30
  30s  c=5
  40s  c=12

# provenance: divergence(rate-counter-window-anchored)
eval instant at 60s rate_counter({env="prod"} | logfmt | unwrap c [1m])
  {env="prod", service_name="checkout"} 0.788888888888889

clear

# Duplicate timestamp, value order (5,{10,3}@20s,12 folds as 5,3,10,12;
# ledger `unwrap-same-nanosecond-value-order`), with F4's extrapolation.
load
  {env="prod", service_name="checkout"} service=checkout
  10s  c=5
  20s  c=10
  20s  c=3
  30s  c=12

# provenance: divergence(unwrap-same-nanosecond-value-order)
eval instant at 60s rate_counter({env="prod"} | logfmt | unwrap c [1m])
  {env="prod", service_name="checkout"} 0.26666666666666666

clear

# Monotone spanning the window (100,160 @ 1ns,60s, span ~60s): increase 60.
load
  {env="prod", service_name="checkout"} service=checkout
  1ns  c=100
  60s  c=160

# provenance: divergence(rate-counter-window-anchored)
eval instant at 60s rate_counter({env="prod"} | logfmt | unwrap c [1m])
  {env="prod", service_name="checkout"} 1.0000000000166667

clear

# Sparse interior samples (200,260 @ 25s,35s, span 10s): extrapolated
# 5 s to each side.
load
  {env="prod", service_name="checkout"} service=checkout
  25s  c=200
  35s  c=260

# provenance: divergence(rate-counter-window-anchored)
eval instant at 60s rate_counter({env="prod"} | logfmt | unwrap c [1m])
  {env="prod", service_name="checkout"} 2

clear

# --- sort / sort_desc value ordering (counts a:5,b:1,c:5) -------------
load
  {env="prod", service_name="svc-sort"} service=svc-sort
  0s   grp=a
  1s   grp=a
  2s   grp=a
  3s   grp=a
  4s   grp=a
  5s   grp=b
  6s   grp=c
  7s   grp=c
  8s   grp=c
  9s   grp=c
  10s  grp=c

# sort: ascending by value. The a/c tie is broken by label set ascending
# -> b,a,c, which is OUR rule (post_agg::sort_instant) and not a reference
# capture: the reference orders on the value alone through an unstable
# sort and specifies no order among equal-valued samples.
# provenance: divergence(sort-tie-order)
eval_ordered instant at 60s sort(sum by (grp) (count_over_time({service_name="svc-sort"} | logfmt [30m])))
  {grp="b"} 1
  {grp="a"} 5
  {grp="c"} 5

# sort_desc: descending by value. Same rule of ours for the a/c tie
# -> a,c,b; same absence of a reference rule to mirror.
# provenance: divergence(sort-tie-order)
eval_ordered instant at 60s sort_desc(sum by (grp) (count_over_time({service_name="svc-sort"} | logfmt [30m])))
  {grp="a"} 5
  {grp="c"} 5
  {grp="b"} 1
