# case 3 — instant, 500 common groups. THE PER-VARIANT-NOT-TOTAL
# PROOF: 500 + 1 = 501 RESULT series, served with no warning.
# Deleting the root-only exemption in `exec.rs` reddens this.
eval instant at 60s variants(sum by (id) (count_over_time({service_name="v277"} | logfmt | id < 500 [1m])), sum(count_over_time({service_name="v277"} | logfmt | id < 500 [1m]))) of ({service_name="v277"} | logfmt | id < 500 [1m])
