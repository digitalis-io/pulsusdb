# case 4 — instant, 501 common groups: variant 0 breaches and is
# REMOVED ENTIRELY (never truncated); variant 1 is served. HTTP 200
# on the reference, not a 4xx.
eval instant at 60s variants(sum by (id) (count_over_time({service_name="v277"} | logfmt | id < 501 [1m])), sum(count_over_time({service_name="v277"} | logfmt | id < 501 [1m]))) of ({service_name="v277"} | logfmt | id < 501 [1m])
  warning: maximum of series (500) reached for variant (0)
  {__variant__="1"} 501

# case 5 — every variant breaches: an EMPTY result and one warning
# per skipped variant, still HTTP 200.
eval instant at 60s variants(count_over_time({service_name="v277"} | logfmt | id < 501 [1m]), bytes_over_time({service_name="v277"} | logfmt | id < 501 [1m])) of ({service_name="v277"} | logfmt | id < 501 [1m])
  warning: maximum of series (500) reached for variant (0)
  warning: maximum of series (500) reached for variant (1)

# case 6 — eleven variants, indices 2 and 10 breaching. The warning
# order is BYTE-LEXICOGRAPHIC, not numeric: `variant (10)` comes
# BEFORE `variant (2)` (the reference renders its warning set with
# `slices.Sorted(maps.Keys(...))`,
# pkg/logqlmodel/metadata/context.go:80-92 @ v3.7.4 b318f282).
eval instant at 60s variants(sum(count_over_time({service_name="v277"} | logfmt | id < 501 [1m])), sum(count_over_time({service_name="v277"} | logfmt | id < 501 [1m])), count_over_time({service_name="v277"} | logfmt | id < 501 [1m]), sum(count_over_time({service_name="v277"} | logfmt | id < 501 [1m])), sum(count_over_time({service_name="v277"} | logfmt | id < 501 [1m])), sum(count_over_time({service_name="v277"} | logfmt | id < 501 [1m])), sum(count_over_time({service_name="v277"} | logfmt | id < 501 [1m])), sum(count_over_time({service_name="v277"} | logfmt | id < 501 [1m])), sum(count_over_time({service_name="v277"} | logfmt | id < 501 [1m])), sum(count_over_time({service_name="v277"} | logfmt | id < 501 [1m])), count_over_time({service_name="v277"} | logfmt | id < 501 [1m])) of ({service_name="v277"} | logfmt | id < 501 [1m])
  warning: maximum of series (500) reached for variant (10)
  warning: maximum of series (500) reached for variant (2)
  {__variant__="0"} 501
  {__variant__="1"} 501
  {__variant__="3"} 501
  {__variant__="4"} 501
  {__variant__="5"} 501
  {__variant__="6"} 501
  {__variant__="7"} 501
  {__variant__="8"} 501
  {__variant__="9"} 501

# case 7 — range grid {60s, 90s, 120s}, window (t-1m, t]. 499 common
# groups: both variants served. At 90s only the ids at offsets in
# (30s, 90s] remain; at 120s the window is empty.
eval range from 60s to 120s step 30s variants(sum by (id) (count_over_time({service_name="v277"} | logfmt | id < 499 [1m])), sum(count_over_time({service_name="v277"} | logfmt | id < 499 [1m]))) of ({service_name="v277"} | logfmt | id < 499 [1m])
