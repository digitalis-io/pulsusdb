# --- served: collapse-to-few over 501 scanned groups -------------------
# Each of these is a 422 on the pre-#236 engine (mid-scan cap at the
# 501st group) and a 200 here and in the reference.

# sum: 507 lines across 501 groups
eval instant at 60s sum(count_over_time({service_name="wide"} | logfmt [1m]))
  {} 507

# count: the number of GROUPS, not lines
eval instant at 60s count(count_over_time({service_name="wide"} | logfmt [1m]))
  {} 501

# min / max over the per-group counts (id=0 has 4 lines, most have 1)
eval instant at 60s min(count_over_time({service_name="wide"} | logfmt [1m]))
  {} 1

eval instant at 60s max(count_over_time({service_name="wide"} | logfmt [1m]))
  {} 4

# sum by a LOW-cardinality label: 501 scanned groups -> 5 result series
eval instant at 60s sum by (bucket) (count_over_time({service_name="wide"} | logfmt [1m]))
  {bucket="0"} 104
  {bucket="1"} 102
  {bucket="2"} 101
  {bucket="3"} 100
  {bucket="4"} 100

# AC 11: an OUTER sum over an INNER `sum by (id)` producing 501 groups
# and collapsing to ONE series. The reference serves this (the inner
# never materialises) while rejecting the bare `sum by (id)` below — the
# case that proves the cap belongs on the RESULT, not on an intermediate.
eval instant at 60s sum(sum by (id) (count_over_time({service_name="wide"} | logfmt [1m])))
  {} 507

# --- served: a sliding RANGE eval, range > step ------------------------
# grid {60s, 90s, 120s}, window (t-1m, t]. At 60s every line is in
# window (507); at 90s only the lines at offsets in (30s, 90s] remain
# (ids 300..500, one line each = 201); at 120s the window is empty and
# no point is emitted. Exercises the streaming fold AND the class-A
# delta-index branch (range >= step).
eval range from 60s to 120s step 30s sum(count_over_time({service_name="wide"} | logfmt [1m]))
  {} 60s 507 90s 201

# --- rejected: the RESULT itself exceeds 500 series --------------------
# The reference's own message, verbatim.

