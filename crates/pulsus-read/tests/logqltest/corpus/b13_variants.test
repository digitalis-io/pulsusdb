# b13_variants.test — issue #221: `variants(<metricExpr>, …) of (<logRangeExpr>)`.
#
# Every accept-case value below was CAPTURED from the pinned reference
# container (never hand-computed):
#   image  docker.io/grafana/loki:3.7.4
#   digest sha256:87f0a067673756a3cede1bcbf0c74875f7df9b09fddb53e399d0c576f756cfcc
#   date   2026-07-26 (capture session)
#   config delta: `limits_config.enable_multi_variant_queries: true` (the
#   bare container 400s EVERY variants query with `multi variant queries
#   are disabled for this instance`) — plus the b10 `shard_aggregations`/
#   `frontend.encoding: protobuf` deltas already documented in
#   PROVENANCE.md (one capture config serves both, `ci/logql/config.yaml`).
#   Transcription discipline (PROVENANCE.md): the container adds
#   `detected_level`/`detected_level_extracted` labels PulsusDB's label
#   model has no analogue for — dropped from every expected label set
#   below; values are unaffected.
#
# PRE-COMMITTED EXCLUSIONS (selection rules, not post-hoc filters):
#   - no case sets `__variant__` in the COMMON pipeline (the reference
#     appends a duplicate label and mis-routes samples — a recorded
#     divergence, docs/benchmarks/logs-differential-ledger.md; PulsusDB
#     pins index-wins, gated hermetically);
#   - no `offset`, no range-aggregation grouping, no case above the
#     series cap (workspace-wide pre-existing gaps / the #236 cap class);
#   - (LIFTED, issue #241 — the sub-case is now case 16s below.) The
#     `sum(absent_over_time(...))` sub-case was excluded because the
#     capture gives `{}` — the injected `by (__variant__)` grouping over
#     the index-less synthetic series — while PulsusDB's `group_key`
#     materialized a MISSING grouped label as `name=""`. That was a
#     PRE-EXISTING engine semantic affecting EVERY `by` over a missing
#     label, nothing variants-specific; #241 fixed it at the root (the
#     `by` key is selected from the series' own labels) and the case is
#     re-captured and pinned. The absent instant/range cases below
#     ARE pinned: the adjudicated capture correction (2026-07-26
#     session; the reference attaches `__variant__` per EXTRACTED
#     SAMPLE, so a synthetic absent series never carries it — index-less
#     and kept at instant, dropped at range).
#
# Reference-observed rejections for the eval_fail cases (both sides
# reject; the status/body divergences are deliberate and ledgered —
# "we do not reproduce the reference where it is self-inconsistent or
# crashing"):
#   sum(variants(…))                    400 syntax error: unexpected )
#   (variants(…))                       400 syntax error: unexpected )
#   topk(1, variants(…))                400 syntax error: unexpected )
#   label_replace(variants(…), …)       400 syntax error: unexpected ,
#   variants() of (…)                   400 syntax error: unexpected )
#   variants(V,) of (…)                 400 syntax error: unexpected )
#   variants(V)  [no of]                400 unexpected $end, expecting of
#   variants(V) of LR  [unparenthesised] 400 unexpected {, expecting (
#   variants(variants(…) of (…)) of (…) 400 syntax error: unexpected )
#   variants(1) of (…)                  500 unexpected empty result
#   variants(V + 1) of (…)              500 runtime error: invalid memory
#                                           address or nil pointer dereference
#   variants(sum(sum(V))) of (…)        500 expected range aggregation
#                                           expression but got *syntax.VectorAggregationExpr
#   variants(approx_topk(1, V)) of (…)  500 expected aggregation operator
#                                           but got "approx_topk"
#   variants(sum_over_time({…}[5m])) of 500 runtime error: invalid memory
#                                           address or nil pointer dereference
#
# provenance: captured
# (file default; see logqltest/PROVENANCE.md §provenance markers.
#  A row may override it with its own `# provenance:` line.)

load
  {env="dev", service_name="svcv"} service=svcv
  10s  ab
  40s  ab
  {env="prod", service_name="svcv"} service=svcv
  15s  ab
  45s  ab
  55s  ab

# case 1 — single count variant: decimal `__variant__="0"`, one series
# per stream (a missing/misspelled index or zero-padding fails here).
eval instant at 60s variants(count_over_time({service_name="svcv"}[5m])) of ({service_name="svcv"}[5m])
  {__variant__="0", env="dev", service_name="svcv"} 2
  {__variant__="0", env="prod", service_name="svcv"} 3

# case 2 — two extractors over ONE scan yield DIFFERENT values per index
# (a one-extractor implementation fails).
eval instant at 60s variants(count_over_time({service_name="svcv"}[5m]), bytes_over_time({service_name="svcv"}[5m])) of ({service_name="svcv"}[5m])
  {__variant__="0", env="dev", service_name="svcv"} 2
  {__variant__="0", env="prod", service_name="svcv"} 3
  {__variant__="1", env="dev", service_name="svcv"} 4
  {__variant__="1", env="prod", service_name="svcv"} 6

# case 3 — a BARE variant's own selector and line filters are DEAD
# SYNTAX: only the common range selects data. BARE only — a variant
# wrapped in a vector aggregation runs its whole pipeline (issue #397;
# the `W` section at the end of this file).
eval instant at 60s variants(count_over_time({service_name="nope"} |= "zzzz" [5m])) of ({service_name="svcv"}[5m])
  {__variant__="0", env="dev", service_name="svcv"} 2
  {__variant__="0", env="prod", service_name="svcv"} 3

# case 4 — each variant honours its OWN [range]: (30s, 60s] sees only
# the 40s/45s/55s samples; the common scan window is [5m]'s.
eval instant at 60s variants(count_over_time({service_name="svcv"}[30s]), count_over_time({service_name="svcv"}[5m])) of ({service_name="svcv"}[5m])
  {__variant__="0", env="dev", service_name="svcv"} 1
  {__variant__="0", env="prod", service_name="svcv"} 2
  {__variant__="1", env="dev", service_name="svcv"} 2
  {__variant__="1", env="prod", service_name="svcv"} 3

# case 5 — `__variant__` is injected into a `by` grouping.
eval instant at 60s variants(sum by (env) (count_over_time({service_name="svcv"}[5m]))) of ({service_name="svcv"}[5m])
  {__variant__="0", env="dev"} 2
  {__variant__="0", env="prod"} 3

# case 6 — a bare `sum` (nil grouping) becomes `by (__variant__)`.
eval instant at 60s variants(sum(count_over_time({service_name="svcv"}[5m]))) of ({service_name="svcv"}[5m])
  {__variant__="0"} 5

# case 7 — `__variant__` is injected into `without` too, which STRIPS
# it; the resulting index-less series is KEPT at instant…
eval instant at 60s variants(sum without (env) (count_over_time({service_name="svcv"}[5m]))) of ({service_name="svcv"}[5m])
  {service_name="svcv"} 5

# case 8 — …and the SAME query at range DROPS it (the reference's
# instant/range asymmetry — the corpus's killer case).
eval range from 0s to 60s step 60s variants(sum without (env) (count_over_time({service_name="svcv"}[5m]))) of ({service_name="svcv"}[5m])

# case 13 — range envelope: matrix, `__variant__` per series, values on
# the shared grid (t=0's window (−1m, 0] is empty — a gap).
eval range from 0s to 60s step 60s variants(count_over_time({service_name="svcv"}[1m]), bytes_over_time({service_name="svcv"}[1m])) of ({service_name="svcv"}[1m])
  {__variant__="0", env="dev", service_name="svcv"} 60s 2
  {__variant__="0", env="prod", service_name="svcv"} 60s 3
  {__variant__="1", env="dev", service_name="svcv"} 60s 4
  {__variant__="1", env="prod", service_name="svcv"} 60s 6

# case 11 — eleven variants: plain decimal `strconv.Itoa` indexes ("10",
# never zero-padded or capped).
eval instant at 60s variants(count_over_time({service_name="svcv"}[5m]), count_over_time({service_name="svcv"}[5m]), count_over_time({service_name="svcv"}[5m]), count_over_time({service_name="svcv"}[5m]), count_over_time({service_name="svcv"}[5m]), count_over_time({service_name="svcv"}[5m]), count_over_time({service_name="svcv"}[5m]), count_over_time({service_name="svcv"}[5m]), count_over_time({service_name="svcv"}[5m]), count_over_time({service_name="svcv"}[5m]), count_over_time({service_name="svcv"}[5m])) of ({service_name="svcv"}[5m])
  {__variant__="0", env="dev", service_name="svcv"} 2
  {__variant__="0", env="prod", service_name="svcv"} 3
  {__variant__="1", env="dev", service_name="svcv"} 2
  {__variant__="1", env="prod", service_name="svcv"} 3
  {__variant__="2", env="dev", service_name="svcv"} 2
  {__variant__="2", env="prod", service_name="svcv"} 3
  {__variant__="3", env="dev", service_name="svcv"} 2
  {__variant__="3", env="prod", service_name="svcv"} 3
  {__variant__="4", env="dev", service_name="svcv"} 2
  {__variant__="4", env="prod", service_name="svcv"} 3
  {__variant__="5", env="dev", service_name="svcv"} 2
  {__variant__="5", env="prod", service_name="svcv"} 3
  {__variant__="6", env="dev", service_name="svcv"} 2
  {__variant__="6", env="prod", service_name="svcv"} 3
  {__variant__="7", env="dev", service_name="svcv"} 2
  {__variant__="7", env="prod", service_name="svcv"} 3
  {__variant__="8", env="dev", service_name="svcv"} 2
  {__variant__="8", env="prod", service_name="svcv"} 3
  {__variant__="9", env="dev", service_name="svcv"} 2
  {__variant__="9", env="prod", service_name="svcv"} 3
  {__variant__="10", env="dev", service_name="svcv"} 2
  {__variant__="10", env="prod", service_name="svcv"} 3

# case 12 — `variants(…) of (…) + 1` is a legal binary operand: every
# variant's value +1, `__variant__` preserved.
eval instant at 60s variants(count_over_time({service_name="svcv"}[5m]), bytes_over_time({service_name="svcv"}[5m])) of ({service_name="svcv"}[5m]) + 1
  {__variant__="0", env="dev", service_name="svcv"} 3
  {__variant__="0", env="prod", service_name="svcv"} 4
  {__variant__="1", env="dev", service_name="svcv"} 5
  {__variant__="1", env="prod", service_name="svcv"} 7

clear

load
  {service_name="svcw"} service=svcw
  5s  {"d":2,"a":10,"b":100}
  15s  {"d":5,"a":7,"b":200}
  25s  {"e":1}

# case 9 — an unwrap variant beside a count variant over one common
# `| json`: each variant gets its OWN unwrap tail (the unwrapped label is
# deleted from variant 0's series; the count variant keeps `d` as a
# label). A line without the unwrap label is silently skipped.
eval instant at 60s variants(sum_over_time({service_name="svcw"} | unwrap d [5m]), count_over_time({service_name="svcw"}[5m])) of ({service_name="svcw"} | json [5m])
  {__variant__="0", a="10", b="100", service_name="svcw"} 2
  {__variant__="0", a="7", b="200", service_name="svcw"} 5
  {__variant__="1", a="10", b="100", d="2", service_name="svcw"} 1
  {__variant__="1", a="7", b="200", d="5", service_name="svcw"} 1
  {__variant__="1", e="1", service_name="svcw"} 1

# case 10 — post-`unwrap` label filters in a variant's tail ARE honoured
# (`ReduceAndLabelFilter(PostFilters)`): `d > 2` keeps only the d=5 line.
eval instant at 60s variants(sum_over_time({service_name="svcw"} | unwrap d | d > 2 [5m]), sum_over_time({service_name="svcw"} | unwrap d [5m])) of ({service_name="svcw"} | json [5m])
  {__variant__="0", a="7", b="200", service_name="svcw"} 5
  {__variant__="1", a="10", b="100", service_name="svcw"} 2
  {__variant__="1", a="7", b="200", service_name="svcw"} 5

clear

load
  {service_name="svcx"} service=svcx
  5s  {"d":2,"a":10,"b":100}
  15s  {"d":5,"a":7,"b":200}
  25s  {"e":1}
  35s  {"d":"x"}

# case 15a (Δ1) — a COMMON-range `unwrap` is DEAD SYNTAX: the common
# pipeline truncates at the first unwrap, so lines whose `d` is missing
# or non-numeric are NOT dropped (an implementation that executes the
# dead unwrap undercounts to 2 and errors on `d="x"`).
eval instant at 60s variants(count_over_time({service_name="svcx"}[5m])) of ({service_name="svcx"} | json | unwrap d [5m])
  {__variant__="0", a="10", b="100", d="2", service_name="svcx"} 1
  {__variant__="0", a="7", b="200", d="5", service_name="svcx"} 1
  {__variant__="0", d="x", service_name="svcx"} 1
  {__variant__="0", e="1", service_name="svcx"} 1

# case 15b (Δ1) — the VARIANT's `unwrap a` runs (against the common
# `| json` extraction); the DEAD common `unwrap b` does not (`b` stays a
# label; an implementation executing it would unwrap `b`, or reject the
# double unwrap).
eval instant at 60s variants(sum_over_time({service_name="svcx"} | unwrap a [5m])) of ({service_name="svcx"} | json | unwrap b [5m])
  {__variant__="0", b="100", d="2", service_name="svcx"} 10
  {__variant__="0", b="200", d="5", service_name="svcx"} 7

# case 15c (Δ1) — the dead common unwrap's POST-FILTER is dead too: all
# d < 1000, yet every line still counts.
eval instant at 60s variants(count_over_time({service_name="svcx"}[5m])) of ({service_name="svcx"} | json | unwrap d | d > 1000 [5m])
  {__variant__="0", a="10", b="100", d="2", service_name="svcx"} 1
  {__variant__="0", a="7", b="200", d="5", service_name="svcx"} 1
  {__variant__="0", d="x", service_name="svcx"} 1
  {__variant__="0", e="1", service_name="svcx"} 1

clear

# --- Rejections (msg = PulsusDB's own error substring; the reference's
# --- observed status+body per case is in the header table above).

load
  {service_name="rj"} service=rj
  10s  ab

# positional: `variantsExpr` is an `expr` alternative, not a
# `metricExpr` — every nested position rejects.
# provenance: divergence(variants-nonconforming-shape-status)
eval_fail instant at 60s sum(variants(count_over_time({service_name="rj"}[5m])) of ({service_name="rj"}[5m]))
  msg: an aggregation function

# provenance: divergence(variants-nonconforming-shape-status)
eval_fail instant at 60s (variants(count_over_time({service_name="rj"}[5m])) of ({service_name="rj"}[5m]))
  msg: an aggregation function

# provenance: divergence(variants-nonconforming-shape-status)
eval_fail instant at 60s topk(1, variants(count_over_time({service_name="rj"}[5m])) of ({service_name="rj"}[5m]))
  msg: an aggregation function

# provenance: divergence(variants-nonconforming-shape-status)
eval_fail instant at 60s label_replace(variants(count_over_time({service_name="rj"}[5m])) of ({service_name="rj"}[5m]), "a", "b", "c", "d")
  msg: an aggregation function

# provenance: divergence(variants-nonconforming-shape-status)
eval_fail instant at 60s variants(variants(count_over_time({service_name="rj"}[5m])) of ({service_name="rj"}[5m])) of ({service_name="rj"}[5m])
  msg: an aggregation function

# grammar shapes.
# provenance: divergence(variants-nonconforming-shape-status)
eval_fail instant at 60s variants() of ({service_name="rj"}[5m])
  msg: an aggregation function

# provenance: divergence(variants-nonconforming-shape-status)
eval_fail instant at 60s variants(count_over_time({service_name="rj"}[5m]),) of ({service_name="rj"}[5m])
  msg: an aggregation function

# provenance: divergence(variants-nonconforming-shape-status)
eval_fail instant at 60s variants(count_over_time({service_name="rj"}[5m]))
  msg: 'of'

# provenance: divergence(variants-nonconforming-shape-status)
eval_fail instant at 60s variants(count_over_time({service_name="rj"}[5m])) of {service_name="rj"}[5m]
  msg: '('

# non-conforming variant shapes — the reference 500s (three texts plus a
# nil-pointer panic, header table); PulsusDB rejects each at plan time
# with one named 400. Both sides reject (ledgered divergence).
# provenance: divergence(variants-nonconforming-shape-status)
eval_fail instant at 60s variants(1) of ({service_name="rj"}[5m])
  msg: must be a range aggregation

# provenance: divergence(variants-nonconforming-shape-status)
eval_fail instant at 60s variants(count_over_time({service_name="rj"}[5m]) + 1) of ({service_name="rj"}[5m])
  msg: must be a range aggregation

# provenance: divergence(variants-nonconforming-shape-status)
eval_fail instant at 60s variants(sum(sum(count_over_time({service_name="rj"}[5m])))) of ({service_name="rj"}[5m])
  msg: must be a range aggregation

# provenance: divergence(variants-nonconforming-shape-status)
eval_fail instant at 60s variants(approx_topk(1, count_over_time({service_name="rj"}[5m]))) of ({service_name="rj"}[5m])
  msg: must be a range aggregation

# unwrap arity is decided by the VARIANT's own pipeline. The reference
# nil-panics on this exact form (header table above), so there is NO
# reference body to pin byte-exactly: the byte-exact row is
# provenance-BLOCKED (issue #240 AC10 — a capture of a different,
# non-variants query must not be substituted; see
# `logqltest/PROVENANCE.md` §#240). This row gates a substring of
# PulsusDB's own wording, which borrows the reference's non-variants
# arity phrasing without claiming reference provenance for it.
# provenance: divergence(variants-nonconforming-shape-status)
eval_fail instant at 60s variants(sum_over_time({service_name="rj"}[5m])) of ({service_name="rj"}[5m])
  msg: invalid aggregation sum_over_time without unwrap

clear

load
  {service_name="svcy"} service=svcy
  10s  hello

# case 16 (Δ2 + the adjudicated absent correction) — an absent variant's
# synthetic labels come from the VARIANT's own (otherwise dead) selector
# (`tier="x"` — a common-selector implementation loses it), and the
# series carries NO `__variant__` (captured; the plan's append-to-every-
# series order was wrong here). The [5m] window before 3600s is a gap.
eval instant at 3600s variants(absent_over_time({service_name="svcy", tier="x"}[5m])) of ({service_name="svcy"}[5m])
  {service_name="svcy", tier="x"} 1

# case 16r — the same query at range: the index-less synthetic series is
# dropped by the instant/range asymmetry (captured: empty matrix).
eval range from 3600s to 3660s step 60s variants(absent_over_time({service_name="svcy", tier="x"}[5m])) of ({service_name="svcy"}[5m])

# case 16s (issue #241, adopted from this file's formerly-EXCLUDED list)
# — the same absent variant under a `sum`. `variants` injects
# `by (__variant__)` into the vector aggregation, the synthetic absent
# series carries no `__variant__` (case 16), and an absent `by` name is
# OMITTED rather than materialised: the answer is `{}`, not
# `{__variant__=""}`. That is the user-visible form of the divergence
# #241 fixed. Re-captured 2026-08-07 on `grafana/loki:3.7.4` (digest
# sha256:87f0a067673756a3cede1bcbf0c74875f7df9b09fddb53e399d0c576f756cfcc,
# the same image this file's other captures name), `ci/logql/config.yaml`.
eval instant at 3600s variants(sum(absent_over_time({service_name="svcy", tier="x"}[5m]))) of ({service_name="svcy"}[5m])
  {} 1

clear

# --- Issue #397: a WRAPPED variant runs its OWN pipeline; a BARE one
# --- does not. The `W` rows below.
#
# The reference type-switches on the variant expression
# (`pkg/logql/syntax/extractor.go:114 @ v3.7.4`). A bare
# `*RangeAggregationExpr` takes `variantRangeAggExprExtractor`, which
# passes `nil` stages (`:186`, `:225`) — its pre-`unwrap` pipeline really
# is dead, which is what cases 1-16s above pin. Anything else falls
# through to `variant.Extractors()` (`:128`), which reaches the FULL
# stage list (`ast.go:1612-1628` -> `extractor.go:52-60`), and the
# consolidated extractor runs it on the line the COMMON pipeline already
# produced (`pkg/logql/log/consolidated_variant_extractor.go:42-60`).
# Exactly one shape has a dead variant pipeline, then: a bare range
# aggregation, parentheses included (W2). Every vector-aggregation
# wrapper makes the whole pipeline live.
#
# Captured 2026-08-10 on `grafana/loki:3.7.4`, digest
# sha256:87f0a067673756a3cede1bcbf0c74875f7df9b09fddb53e399d0c576f756cfcc
# (the same image this file's other captures name), `ci/logql/config.yaml`.
# The load below was pushed at a base timestamp ALIGNED to a 60s
# boundary, so the reference's own step grid (which floors/ceils to a
# multiple of `step`) coincides exactly with W25/W26's `from 0s to 60s
# step 60s` and the two grids are comparable point for point. At an
# UNALIGNED base they are not — a plain `count_over_time({...}[1m])`
# with no variants involved already answers on a different grid here and
# there, which is why no `W` row compares a shifted grid.
#
# WHAT THIS SECTION CANNOT SAY, AND THE ISSUE THAT OWNS IT: **#278**
# (open since 2026-07-27). This runner compiles the pipeline instead of
# planning it, and `compile_stage` elides a PUSHABLE line filter because
# the scan plan renders it into SQL — so in a hermetic run there is no
# SQL to render it into and the filter is simply not applied. That makes
# EVERY metric row in this corpus blind to a pushable line filter on the
# COMMON side, not just the rows below: it is a property of the runner,
# not of `variants(...)`. W11 and W12 therefore put their common-side
# filter in a LABEL filter, which is never pushed down. The VARIANT side
# is unaffected — a variant tail is never rendered into SQL, which is
# exactly what issue #397 fixed, and W3 is that row.
#
# Reference-observed statuses for the eval_fail rows below (both sides
# reject or both sides answer; PulsusDB's own substring is on the row):
#   W27 variants(sum by (env) (count_over_time(S | json [5m]))) of (S[5m])
#       500 unexpected empty result
#   W28 the same wrapped variant BESIDE a clean one
#       200, silently DROPPING the erroring variant
#   W29 variants(sum by (env) (count_over_time(S |~ "[" [5m]))) of (S[5m])
#       400 parse error : stage '|~ "["' — both reject; parity, newly
#       gained (a BARE malformed pushable regex stays a 200 here, the
#       #400 divergence, which this section does not move)

load
  {env="a", service_name="v397"} service=v397
  0s   lvl=alpha n=1
  5s   lvl=alpha n=2
  10s  lvl=beta n=4
  {env="b", service_name="v397"} service=v397
  1s   lvl=alpha n=8
  6s   lvl=beta n=16
  11s  lvl=beta n=32

# W1 — BARE: the variant's `|= "alpha"` is dead, so every line counts.
eval instant at 60s variants(count_over_time({service_name="v397"} |= "alpha" [5m])) of ({service_name="v397"}[5m])
  {__variant__="0", env="a", service_name="v397"} 3
  {__variant__="0", env="b", service_name="v397"} 3

# W2 — parenthesising a bare range aggregation does NOT wrap it: both
# grammars erase the parens, so this is still the bare arm.
eval instant at 60s variants((count_over_time({service_name="v397"} |= "alpha" [5m]))) of ({service_name="v397"}[5m])
  {__variant__="0", env="a", service_name="v397"} 3
  {__variant__="0", env="b", service_name="v397"} 3

# W3 — WRAPPED: the same filter is LIVE. THE HEADLINE ROW — 2 and 1, not
# 3 and 3. A fix that sets the tail without disabling the pushable
# line-filter elision still answers 3 and 3 here.
eval instant at 60s variants(sum by (env) (count_over_time({service_name="v397"} |= "alpha" [5m]))) of ({service_name="v397"}[5m])
  {__variant__="0", env="a"} 2
  {__variant__="0", env="b"} 1

# W4 — BARE, filter matching nothing: still every line.
eval instant at 60s variants(count_over_time({service_name="v397"} |= "nomatch" [5m])) of ({service_name="v397"}[5m])
  {__variant__="0", env="a", service_name="v397"} 3
  {__variant__="0", env="b", service_name="v397"} 3

# W5 — WRAPPED, the same filter: EMPTY. The issue's second row.
eval instant at 60s variants(sum by (env) (count_over_time({service_name="v397"} |= "nomatch" [5m]))) of ({service_name="v397"}[5m])

# W6 — the per-variant proof in ONE query over ONE scan: variants 0 and
# 2 are bare and keep every line; variant 1 is wrapped and filters.
eval instant at 60s variants(count_over_time({service_name="v397"} |= "alpha" [5m]), sum by (env) (count_over_time({service_name="v397"} |= "alpha" [5m])), bytes_over_time({service_name="v397"} |= "alpha" [5m])) of ({service_name="v397"}[5m])
  {__variant__="0", env="a", service_name="v397"} 3
  {__variant__="0", env="b", service_name="v397"} 3
  {__variant__="1", env="a"} 2
  {__variant__="1", env="b"} 1
  {__variant__="2", env="a", service_name="v397"} 38
  {__variant__="2", env="b", service_name="v397"} 39

# W7 — BARE with its OWN grouping: the split is "wrapped in a vector
# aggregation", NOT "declares a grouping". A grouping-keyed fix drops
# the beta group (the variant's `|= "alpha"` would filter it out).
eval instant at 60s variants(max_over_time({service_name="v397"} |= "alpha" | logfmt | unwrap n [5m]) by (lvl)) of ({service_name="v397"} | logfmt [5m])
  {__variant__="0", lvl="alpha"} 8
  {__variant__="0", lvl="beta"} 32

# W8 — the same expression WRAPPED: one group survives.
eval instant at 60s variants(sum by (lvl) (max_over_time({service_name="v397"} |= "alpha" | logfmt | unwrap n [5m]) by (lvl))) of ({service_name="v397"} | logfmt [5m])
  {__variant__="0", lvl="alpha"} 8

# W9 — ORDER: the wrapped variant's pipeline runs AFTER the common one,
# on the line the common one produced. The common `line_format` has
# rewritten every line to `lvl=zz`, so the variant's `| logfmt |
# lvl="alpha"` matches nothing. Running the variant pipeline on the RAW
# line (or before the common one, or instead of it) answers 2 and 1.
eval instant at 60s variants(sum by (env) (count_over_time({service_name="v397"} | logfmt | lvl="alpha" [5m]))) of ({service_name="v397"} | line_format "lvl=zz" [5m])

# W10 — the same shape asking for what the COMMON pipeline produced:
# 3 and 3. W9's emptiness is composition, not a broken pipeline.
eval instant at 60s variants(sum by (env) (count_over_time({service_name="v397"} | logfmt | lvl="zz" [5m]))) of ({service_name="v397"} | line_format "lvl=zz" [5m])
  {__variant__="0", env="a"} 3
  {__variant__="0", env="b"} 3

# W11 — BOTH sides filter and the answer is the intersection: of the
# three `env="b"` lines the common filter keeps, one holds `alpha`.
#
# The common filter here is a LABEL filter, deliberately, and the reason
# is **issue #278** (open since 2026-07-27) — a property of this runner
# rather than of variants. A PUSHABLE line filter on the common side is
# elided from the compiled client pipeline (`pipeline.rs`'s
# `compile_stage`) because the scan plan renders it into SQL — and this
# corpus is hermetic, so there is no SQL to render it into. Every metric
# row in this corpus is blind to a pushed-down common line filter for the
# same reason; a label filter is not pushed down and so does the same job
# in a form the runner can evaluate. (Issue #397's own fix is about the
# VARIANT side's filters, which are never pushed down and now always
# compile — W3 is that row.) The pushed-down-common case is covered
# live instead, on the real SQL path, in issue #397's notes.
eval instant at 60s variants(sum by (env) (count_over_time({service_name="v397"} |= "alpha" [5m]))) of ({service_name="v397"} | env="b" [5m])
  {__variant__="0", env="b"} 1

# W12 — the bare twin of W11: only the common filter applies, so all
# three of its lines count.
eval instant at 60s variants(count_over_time({service_name="v397"} |= "alpha" [5m])) of ({service_name="v397"} | env="b" [5m])
  {__variant__="0", env="b", service_name="v397"} 3

# W13 — the second, independent ordering witness, in bytes: the common
# `line_format "z"` makes each line 1 byte, the variant's `line_format
# "abcd"` then makes it 4, so 3 lines per stream measure 12. Applying
# them in the other order measures 3.
eval instant at 60s variants(sum by (env) (bytes_over_time({service_name="v397"} | line_format "abcd" [5m]))) of ({service_name="v397"} | line_format "z" [5m])
  {__variant__="0", env="a"} 12
  {__variant__="0", env="b"} 12

# W14 — the bare twin of W13: the variant's `line_format` is dead, so
# the common `"z"` decides the byte count.
eval instant at 60s variants(bytes_over_time({service_name="v397"} | line_format "abcd" [5m])) of ({service_name="v397"} | line_format "z" [5m])
  {__variant__="0", env="a", service_name="v397"} 3
  {__variant__="0", env="b", service_name="v397"} 3

# W15 — a wrapped variant's PARSER is live too, so `by (lvl)` finds the
# extracted label: two groups, not one `{}` of 6.
eval instant at 60s variants(sum by (lvl) (count_over_time({service_name="v397"} | logfmt [5m]))) of ({service_name="v397"}[5m])
  {__variant__="0", lvl="alpha"} 3
  {__variant__="0", lvl="beta"} 3

# W16 — a wrapped variant's pre-`unwrap` parser feeds its own `unwrap`:
# without the live `| logfmt` the `unwrap n` finds nothing and the
# answer is empty instead of 3 and 8.
eval instant at 60s variants(sum by (env) (sum_over_time({service_name="v397"} |= "alpha" | logfmt | unwrap n [5m]))) of ({service_name="v397"} | logfmt [5m])
  {__variant__="0", env="a"} 3
  {__variant__="0", env="b"} 8

# W17 — the bare twin of W16: the variant's `|= "alpha"` and `| logfmt`
# are dead, the common `| logfmt` supplies `n`, and every line sums.
eval instant at 60s variants(sum_over_time({service_name="v397"} |= "alpha" | logfmt | unwrap n [5m])) of ({service_name="v397"} | logfmt [5m])
  {__variant__="0", env="a", lvl="alpha", service_name="v397"} 3
  {__variant__="0", env="a", lvl="beta", service_name="v397"} 4
  {__variant__="0", env="b", lvl="alpha", service_name="v397"} 8
  {__variant__="0", env="b", lvl="beta", service_name="v397"} 48

# W18 — a wrapped `absent_over_time` whose live filter matches nothing:
# the synthetic absent series exists, so the sum is 1.
eval instant at 60s variants(sum(absent_over_time({service_name="v397"} |= "zzz" [5m]))) of ({service_name="v397"}[5m])
  {} 1

# W19 — …and with a filter that DOES match, nothing is absent: empty.
eval instant at 60s variants(sum(absent_over_time({service_name="v397"} |= "alpha" [5m]))) of ({service_name="v397"}[5m])

# W20 — the bare twin: the filter is dead, lines are present, empty.
eval instant at 60s variants(absent_over_time({service_name="v397"} |= "zzz" [5m])) of ({service_name="v397"}[5m])

# W21 — a live REGEX line filter (also pushable, so it exercises the
# same elision as W3).
eval instant at 60s variants(sum by (env) (count_over_time({service_name="v397"} |~ "alp.a" [5m]))) of ({service_name="v397"}[5m])
  {__variant__="0", env="a"} 2
  {__variant__="0", env="b"} 1

# W22 — a live NEGATED line filter: the complement of W3.
eval instant at 60s variants(sum by (env) (count_over_time({service_name="v397"} != "alpha" [5m]))) of ({service_name="v397"}[5m])
  {__variant__="0", env="a"} 1
  {__variant__="0", env="b"} 2

# W23 — a live `ip(...)` line filter, which is NOT pushable and so was
# already compiled client-side: no line holds that address.
eval instant at 60s variants(sum by (env) (count_over_time({service_name="v397"} |= ip("1.2.3.4") [5m]))) of ({service_name="v397"}[5m])

# W24 — a live pre-`unwrap` LABEL filter: `| json` fails on every
# logfmt line, so `__error__=""` keeps none.
eval instant at 60s variants(sum by (env) (count_over_time({service_name="v397"} | json | __error__="" [5m]))) of ({service_name="v397"}[5m])

# W25 — the wrapped arm at RANGE (grid-aligned capture, see the section
# header): t=0's (-5m, 0] window holds only env=a's 0s line.
eval range from 0s to 60s step 60s variants(sum by (env) (count_over_time({service_name="v397"} |= "alpha" [5m]))) of ({service_name="v397"}[5m])
  {__variant__="0", env="a"} 0s 1 60s 2
  {__variant__="0", env="b"} 60s 1

# W26 — the bare arm at range: the dead filter, so every line counts.
eval range from 0s to 60s step 60s variants(count_over_time({service_name="v397"} |= "alpha" [5m])) of ({service_name="v397"}[5m])
  {__variant__="0", env="a", service_name="v397"} 0s 1 60s 3
  {__variant__="0", env="b", service_name="v397"} 60s 3

# W27 — a wrapped variant whose now-live pipeline errors on every line.
# PulsusDB 400s (the same surface the identical non-variants query gets,
# which the reference also 400s outside `variants`); inside `variants`
# the reference 500s. Ledgered: `variants-surviving-error-status`.
# provenance: divergence(variants-surviving-error-status)
eval_fail instant at 60s variants(sum by (env) (count_over_time({service_name="v397"} | json [5m]))) of ({service_name="v397"}[5m])
  msg: pipeline error: 'JSONParserErr'

# W28 — the same erroring variant BESIDE a clean one. The reference
# answers 200 and silently DROPS the broken variant — wrong data with
# nothing to show for it. We refuse the query instead (same ledger row).
# provenance: divergence(variants-surviving-error-status)
eval_fail instant at 60s variants(count_over_time({service_name="v397"}[5m]), sum by (env) (count_over_time({service_name="v397"} | json [5m]))) of ({service_name="v397"}[5m])
  msg: pipeline error: 'JSONParserErr'

# W29 — a malformed PUSHABLE regex in a WRAPPED variant is now a 400
# here, agreeing with the reference's own 400. The bare position still
# serves 200 (the #400 divergence), which is why `docs/api.md` and the
# ledger say "bare".
eval_fail instant at 60s variants(sum by (env) (count_over_time({service_name="v397"} |~ "[" [5m]))) of ({service_name="v397"}[5m])
  msg: bad regex
