eval_fail instant at 60s count_over_time({service="rr11M"} | logfmt [5m])
  msg: pipeline error: 'boom'

clear

# rr13M
load
  {service="rr13M", service_name="rr13M"}
  0s  {"latency":5}

eval instant at 60s label_replace(count_over_time({service="rr13M"} [5m]), "__error__", "boom", "", "")
  {__error__="boom", service="rr13M", service_name="rr13M"} 1

clear
