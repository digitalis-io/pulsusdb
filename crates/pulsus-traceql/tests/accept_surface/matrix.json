{
  "language_target": "TraceQL as shipped in Tempo v3.0.2",
  "captured": "2026-08-02",
  "owning_issue": 335,
  "method": "black-box: every probe replayed against an unmodified grafana/tempo:3.0.2 container; 2xx=accept, 400=reject. Where the reference answered 400 with a type error it echoed its own fully parenthesised parse, which is recorded verbatim in reference_parse and is what fixes the precedence table. No Tempo source was read.",
  "divergence_classes": [
    {
      "id": "D1",
      "title": "unary '!' binds looser than comparison",
      "reference": "'!' is an operand-level unary: it binds tighter than every comparison operator and tighter than '+'/'-', but looser than '^' and '*'/'/'/'%'.",
      "pulsus": "'!' negates a whole field primary, i.e. the entire comparison.",
      "impact": "accept-surface AND quiet meaning",
      "status": "open",
      "deferred_to": "the field-expression regrammar tracked on #335"
    },
    {
      "id": "D2",
      "title": "colon-scoped intrinsic rejected as a comparison right-hand side",
      "reference": "Every colon-scoped intrinsic is an ordinary operand and is legal on either side.",
      "pulsus": "The right-hand-side field predicate recognises dotted attributes and bare intrinsics only.",
      "impact": "accept-surface",
      "status": "closed",
      "closed_by": 335
    },
    {
      "id": "D3",
      "title": "unary '-' rejected outside the right-hand side",
      "reference": "Unary '-' is an operand-level unary, legal anywhere an operand is.",
      "pulsus": "Accepted only when the right-hand side already begins an arithmetic operand.",
      "impact": "accept-surface",
      "status": "open",
      "deferred_to": "the field-expression regrammar tracked on #335"
    },
    {
      "id": "D4",
      "title": "a literal is rejected at the comparison left-hand side",
      "reference": "Both sides of a comparison are full field expressions, so a literal (or a literal-only comparison) is legal.",
      "pulsus": "The left-hand side must begin with a field.",
      "impact": "accept-surface",
      "status": "open",
      "deferred_to": "the field-expression regrammar tracked on #335"
    },
    {
      "id": "D5",
      "title": "a parenthesised expression is rejected at the comparison left-hand side",
      "reference": "Parentheses are an operand, so '(.a) = 1' and '(.a + 1) = 2' are legal.",
      "pulsus": "A parenthesised field expression may only be a whole boolean primary.",
      "impact": "accept-surface",
      "status": "open",
      "deferred_to": "the field-expression regrammar tracked on #335"
    },
    {
      "id": "D6",
      "title": "chained comparison rejected",
      "reference": "Comparison operators are left-associative binary operators and chain: 'a = b = c' parses as '(a = b) = c'.",
      "pulsus": "A second comparison operator is a positioned grammar error.",
      "impact": "accept-surface",
      "status": "open",
      "deferred_to": "the field-expression regrammar tracked on #335"
    },
    {
      "id": "D7",
      "title": "aggregate argument must be a bare field",
      "reference": "An aggregate argument is a full field expression (arithmetic, unary, parentheses, any intrinsic).",
      "pulsus": "Restricted to 'duration' or an attribute.",
      "impact": "accept-surface",
      "status": "open",
      "deferred_to": "the field-expression regrammar tracked on #335"
    },
    {
      "id": "D8",
      "title": "'^' associativity",
      "reference": "left-associative: 2 ^ 3 ^ 2 = 64.",
      "pulsus": "right-associative: 2 ^ (3 ^ 2) = 512.",
      "impact": "quiet meaning",
      "status": "closed",
      "closed_by": 335
    },
    {
      "id": "D9",
      "title": "unary '-' versus '^'",
      "reference": "'^' binds tighter than unary '-': -2 ^ 2 = -4.",
      "pulsus": "unary '-' binds tighter: (-2) ^ 2 = 4.",
      "impact": "quiet meaning",
      "status": "closed",
      "closed_by": 335
    },
    {
      "id": "D10",
      "title": "'&&' versus '||' inside a spanset filter",
      "reference": "one precedence level, left-associative: 'a || b && c' parses as '(a || b) && c'.",
      "pulsus": "'&&' binds tighter than '||'.",
      "impact": "quiet meaning",
      "status": "closed",
      "closed_by": 335
    },
    {
      "id": "D11",
      "title": "'&&' versus '||' between spansets",
      "reference": "one precedence level, left-associative (established by result differential, not status).",
      "pulsus": "'&&' binds tighter than '||'.",
      "impact": "quiet meaning",
      "status": "closed",
      "closed_by": 335
    }
  ],
